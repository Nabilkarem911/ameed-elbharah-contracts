# PostgreSQL connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ameed_credit?schema=public"

# Public URL used to generate customer links
# APP_URL is read at runtime, so it can be changed without rebuilding.
# NEXT_PUBLIC_APP_URL is a build-time fallback (useful for any client-side code).
APP_URL="http://localhost:3000"
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin dashboard credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="changeme"

# Environment
NODE_ENV="development"
